{
 "Dhcp4": {
  "interfaces-config": { "interfaces": ["{{ vrrp_interface }}"] },
  "lease-database": { "type": "memfile", "persist": true, "lfc-interval": 3600 },
  "valid-lifetime": {{ dhcp_lease_seconds }},
  "hooks-libraries": [{
    "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_ha.so",
    "parameters": { "high-availability": [{
      "this-server-name": "{{ inventory_hostname }}",
      "mode": "hot-standby",
      "heartbeat-delay": 10000, "max-response-delay": 60000, "max-ack-delay": 5000, "max-unacked-clients": 5,
      "peers": [
        { "name": "aaa-01", "url": "http://10.20.0.11:8000/", "role": "primary" },
        { "name": "aaa-02", "url": "http://10.20.0.12:8000/", "role": "standby" }
      ]}]}
  }],
  "subnet4": [{
    "subnet": "{{ dhcp_subnet }}",
    "pools": [{ "pool": "{{ dhcp_pool }}" }],
    "option-data": [
      { "name": "routers", "data": "100.64.0.1" },
      { "name": "domain-name-servers", "data": "{{ service_vip }}" }
    ]
  }],
  "loggers": [{ "name": "kea-dhcp4", "severity": "INFO", "output_options": [{ "output": "syslog" }] }]
 }
}
