sql {
    dialect = "postgresql"
    driver = "rlm_sql_${dialect}"
    server = "{{ radius_db_host }}"
    port = 5432
    login = "radius"
    password = "{{ vault_radius_db_password }}"
    radius_db = "radius"
    read_clients = no
    pool { start = 5  min = 4  max = 32  spare = 3  uses = 0  lifetime = 0  idle_timeout = 60 }
}
