{
  "Dhcp4": {
    "interfaces-config": { "interfaces": ["{{ ansible_default_ipv4.interface }}"] },
    "lease-database": { "type": "memfile", "persist": true },
    "valid-lifetime": 3600,
    "option-data": [ { "name": "domain-name-servers", "data": "{{ service_vip }}" } ],
    "subnet4": [ { "subnet": "10.30.0.0/16", "pools": [ { "pool": "10.30.1.1 - 10.30.255.254" } ],
                   "option-data": [ { "name": "routers", "data": "10.30.0.1" } ] } ],
    "hooks-libraries": [ { "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_ha.so",
      "parameters": { "high-availability": [ {
        "this-server-name": "{{ inventory_hostname }}", "mode": "hot-standby",
        "heartbeat-delay": 10000, "max-response-delay": 60000, "max-ack-delay": 5000, "max-unacked-clients": 5,
        "peers": [
          { "name": "svc-01", "url": "http://10.20.0.11:8000/", "role": "primary" },
          { "name": "svc-02", "url": "http://10.20.0.12:8000/", "role": "standby" } ] } ] } } ],
    "loggers": [ { "name": "kea-dhcp4", "output_options": [ { "output": "syslog" } ], "severity": "INFO" } ]
  }
}
